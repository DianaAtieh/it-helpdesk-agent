<mxfile host="app.diagrams.net" type="device"><diagram name="Brief 1 · The conversation as a state machine" id="32097d79729f"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Brief 1 · The conversation as a state machine&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Each box is a LangGraph node, each diamond a decision in code. Text first: voice is a layer around this graph." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;spoken or typed&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#1a3c5e;strokeColor=#1a3c5e;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="382" width="120" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Understand&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;extract service, day, time window, name, phone&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="360" width="170" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;All details?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="385" y="350" width="150" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Collect&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;ask ONE question for what&amp;#x27;s missing&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="375" y="160" width="170" height="92" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Check availability&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;find_slots (MCP)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff5e1;strokeColor=#c98a00;fontColor=#5c3b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="575" y="360" width="170" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Real slots?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="350" width="150" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Alternatives&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;nearest real slots · another day or provider&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="160" width="170" height="92" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Propose &amp;amp; read back&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;≤ 3 real slots · exact service, day, time, provider&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="965" y="360" width="170" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Await approval&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;return pending_action · stop here&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1170" y="360" width="180" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Approved?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1185" y="520" width="150" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;nothing booked · offer the next step&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#8a8886;fontColor=#323130;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1400" y="540" width="170" height="82" as="geometry"/></mxCell><mxCell id="c16" value="&lt;span style=&#x27;font-size:9px;color:#c50f1f&#x27;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Book · in code&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;create_booking via MCP · Idempotency-Key&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1170" y="700" width="180" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Result?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff5e1;strokeColor=#c98a00;fontColor=#5c3b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="935" y="690" width="150" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Confirmed&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;BK- ID from the API · speak it · save_patient&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf6eb;strokeColor=#2e7d32;fontColor=#1b4d1f;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="700" width="200" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;503 · timeout → honest failure, no ID&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="935" y="842" width="150" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Out of scope&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;medical question · emergency&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="560" width="170" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Safe reply&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;no advice · the emergency message · offer to book&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="700" width="170" height="100" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Cancel · reschedule&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;stretch goal: each write behind its own approval&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3f2f1;strokeColor=#c8c6c4;fontColor=#605e5c;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="200" height="100" as="geometry"/></mxCell><mxCell id="c23" value="Dates are code: the LLM extracts “next Tuesday after 4”, Python turns it into a date in Asia/Jerusalem from the clinic&amp;#x27;s “today”." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeC