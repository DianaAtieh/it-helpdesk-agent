<mxfile host="app.diagrams.net" type="device"><diagram name="Brief 2 · The IT Helpdesk Agent: the blueprint" id="dfa075921d13"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Brief 2 · The IT Helpdesk Agent: the blueprint&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Two pipelines, both yours: ingestion (offline) and the conversation (online). The ticket system sits behind MCP." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;From the kit · the dataset&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;html=1;whiteSpace=wrap;fillColor=#fff8ec;strokeColor=#c98a00;fontColor=#5c3b00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="300" height="175" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;You build · ingestion (offline, re-runnable)&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;html=1;whiteSpace=wrap;fillColor=#f0f7fd;strokeColor=#0078d4;fontColor=#0b3a66;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="900" height="175" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Real services&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;html=1;whiteSpace=wrap;fillColor=#f1f9f2;strokeColor=#2e7d32;fontColor=#1b4d1f;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;" vertex="1" par