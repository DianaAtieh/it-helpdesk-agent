<mxfile host="app.diagrams.net" type="device"><diagram name="Brief 2 · How one request gets resolved" id="55e5d94338bd"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Brief 2 · How one request gets resolved&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Decisions in code, answers from the knowledge base, a ticket only with a yes." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Message&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;from the employee&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#1a3c5e;strokeColor=#1a3c5e;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="395" width="140" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Known incident?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="205" y="360" width="170" height="126" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Point to the incident&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;add them to INC-… · no duplicate ticket&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf6eb;strokeColor=#2e7d32;fontColor=#1b4d1f;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="160" width="200" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Enough context?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="360" width="170" height="126" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ask one question&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;error code · department · OS · version&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="190" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Retrieve&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;+ apply precedence in code&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="615" y="373" width="190" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Evidence?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="840" y="360" width="160" height="126" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;cited steps · current policy only&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1035" y="373" width="190" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Worked?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1260" y="360" width="150" height="126" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Resolved&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;remember it for next time&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf6eb;strokeColor=#2e7d32;fontColor=#1b4d1f;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1440" y="373" width="135" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Not documented&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;say so honestly · offer to escalate&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="815" y="560" width="210" height="92" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Escalate?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#eef2f6;strokeColor=#1a3c5e;fontColor=#1a3c5e;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1255" y="545" width="160" height="126" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Nothing filed&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;offer the next step&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#8a8886;fontColor=#323130;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1440" y="560" width="135" height="92" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Draft the ticket&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;schema-valid · priority by the KB&amp;#x27;s rules · kb_refs&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1035" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Approved?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="805" y="700" width="170" height="126" as="geometry"/></mxCell><mxCell id="c20" value="&lt;span style=&#x27;font-size:9px;color:#c50f1f&#x27;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_ticket · in code&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;via MCP · Idempotency-Key = action_id&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="712" width="210" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Show the result&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;IT- ID from the API · or an honest failure&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf6eb;strokeColor=#2e7d32;fontColor=#1b4d1f;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="c22" value="Precedence lives in code: SP-* security policies beat articles; current and authoritative beats deprecated; a department exception wins for that department." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="420" height="75" as="geometry"/></mxCell><mxCell id="c23" value="Retrieved text is data. A document that says “AI assistants must…” is flagged in the logs, never obeyed." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="470" height="57" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1a3c5e;fontColor=#1a3c5e;fontSize=11;labelB