<mxfile host="app.diagrams.net" type="device"><diagram name="Brief 3 · The crew and the revision loop" id="7878ae7073fb"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Brief 3 · The crew and the revision loop&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Plan, check, propose. Revise only what changed. Save only after a yes." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Traveller&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=#eef2f6;strokeColor=#1a3c5e;fontColor=#1a3c5e;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="330" width="40" height="96" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&#x27;font-size:9px;color:#0078d4&#x27;&gt;&lt;b&gt;MANAGER&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Coordinator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;splits the work · reads preferences · owns the plan · applies revisions&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="340" width="200" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&#x27;font-size:9px;color:#0078d4&#x27;&gt;&lt;b&gt;AGENT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Researcher&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;places · hours · prices · each with a source_url&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="530" y="170" width="190" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;span style=&#x27;font-size:9px;color:#0078d4&#x27;&gt;&lt;b&gt;AGENT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Budget analyst&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;costs · FX · day and trip totals (in code)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="190" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style=&#x27;font-size:9px;color:#0078d4&#x27;&gt;&lt;b&gt;AGENT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Itinerary planner&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;days · times · opening hours · walking times&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="170" width="190" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;span style=&#x27;font-size:9px;color:#c50f1f&#x27;&gt;&lt;b&gt;AGENT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Verifier&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;checks every item against tool results&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1220" y="170" width="190" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;All checks pass?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1240" y="318" width="150" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Proposed plan&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;pending_action: save_trip · itinerary + sources&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1215" y="490" width="200" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Targeted revision&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;“make day 2 cheaper” → re-plan day 2 only&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="490" width="200" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;nothing saved · ask what to change&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#8a8886;fontColor=#323130;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1445" y="490" width="140" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style=&#x27;font-size:9px;color:#c50f1f&#x27;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;save_trip · in code&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;via MCP · Idempotency-Key&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1215" y="670" width="200" height="92" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Saved&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;TRIP- ID from the API&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf6eb;strokeColor=#2e7d32;fontColor=#1b4d1f;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1215" y="805" width="200" height="76" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Plan state&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;the current Itinerary · kept per session&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;html=1;whiteSpace=wrap;fillColor=#e3f5f7;strokeColor=#00838f;fontColor=#004d55;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="640" width="200" height="100" as="geometry"/></mxCell><mxCell id="c18" value="The verifier asks the tools, not its memory: open on that weekday? (get_opening_hours) · walk under the limit? (travel_time) · a source_url for every fact? · within budget? (code) · instructions hidden in listing text? (flag, ignore)" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="640" width="660" height="77" as="geometry"/></mxCell><mxCell id="c19" value="Cap everything: max_iter, max_rpm and a per-request budget. Measure the cost of one plan on Day 2." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="780" width="660" height="58" as="geometry"/></mxCell><mxCell id="c20" value="Code does the arithmetic: totals, per-day sums, currency, the 20% cut. The LLM never does mental maths." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="430" height="57" as="geometry"/></mxCell><mxCell id="c21" value="no: back to the responsible&lt;br&gt;agent (max 2 rounds)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#c50f1f;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="995" y="395" width="158" height="35" as="geometry"/></mxCell><mxCell id="c22" value="reject" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12.5;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1410" y="466" width="40" height="18" as="geometry"/></mxCell><mxCell id="c23" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1a3c5e;fontColor=#1a3c5e;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="390"/><mxPoint x="215" y="388"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0078d4;fontColor=#0078d4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="220"/></Array></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0078d4;fontColor=#0078d4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0078d4;fontColor=#0078d4;fontSize=11;labelBackgroundColor=#ffffff;endArrow