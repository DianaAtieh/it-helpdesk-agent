<mxfile host="app.diagrams.net" type="device"><diagram name="Brief 3 · The Trip Planning Crew: the blueprint" id="028e4a05ea7d"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Brief 3 · The Trip Planning Crew: the blueprint&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="A crew of specialists on real open data, behind MCP. The plan is state. Saving needs a yes. Nothing is ever booked." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Traveller&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;html=1;whiteSpace=wrap;fillColor=#f4f7f9;strokeColor=#1a3c5e;fontColor=#1a3c5e;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="210" height="740" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Your system · FastAPI on port 8000&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;html=1;whiteSpace=wrap;fillColor=#f0f7fd;strokeColor=#0078d4;fontColor=#0b3a66;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="120" width="860" height="740" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;The crew · CrewAI&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;html=1;whiteSpace=wrap;fillColor=#f0f7fd;strokeColor=#0078d4;fontColor=#0b3a66;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometr