" as="geometry"/></mxCell><mxCell id="c17" value="&lt;span style=&#x27;font-size:9px;color:#0078d4&#x27;&gt;&lt;b&gt;AGENT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Budget analyst&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;costs · exchange rates · totals in code&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="630" y="330" width="140" height="150" as="geometry"/></mxCell><mxCell id="c18" value="&lt;span style=&#x27;font-size:9px;color:#0078d4&#x27;&gt;&lt;b&gt;AGENT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Itinerary planner&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;days · times · opening hours · walks&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="140" height="150" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style=&#x27;font-size:9px;color:#c50f1f&#x27;&gt;&lt;b&gt;AGENT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Verifier&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;open that day? feasible? sourced? in budget?&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="330" width="140" height="150" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Plan state&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;a Pydantic Itinerary per session · revisions edit it&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;html=1;whiteSpace=wrap;fillColor=#e3f5f7;strokeColor=#00838f;fontColor=#004d55;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="610" width="290" height="110" as="geometry"/></mxCell><mxCell id="c21" v