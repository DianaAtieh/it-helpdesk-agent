<mxfile host="app.diagrams.net" type="device"><diagram name="The Ship Week: something that runs on Day 3, better every day after" id="752ebb3e3ee1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;The Ship Week: something that runs on Day 3, better every day after&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="One week from the kickoff session to the demo session. Each check-in is a comment on your registration issue." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Design&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;kit runs · DESIGN.md reviewed&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1a3c5e;strokeColor=#1a3c5e;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="94" y="372" width="170" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Walking skeleton&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;UI → API → agent → MCP tool → reply&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="272" y="372" width="347" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Core&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;happy path · approval gate · memory · sample cases&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#7a43b6;strokeColor=#7a43b6;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="626" y="372" width="347" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Harden&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;guardrails · failures · your own cases · fix one&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#c50f1f;strokeColor=#c50f1f;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="982" y="372" width="170" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Pre-flight&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;another pair runs it from your README · video&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#c98a00;strokeColor=#c98a00;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1159" y="372" width="170" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Demo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;tag v1.0 · 6 minutes + Q&amp;amp;A&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#2e7d32;strokeColor=#2e7d32;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1336" y="372" width="170" height="100" as="geometry"/></mxCell><mxCell id="c11" value="" style="rhombus;html=1;whiteSpace=wrap;fillColor=#1a3c5e;strokeColor=#1a3c5e;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="224" y="582" width="36" height="36" as="geometry"/></mxCell><mxCell id="c12" value="" style="rhombus;html=1;whiteSpace=wrap;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="582" width="36" height="36" as="geometry"/></mxCell><mxCell id="c13" value="" style="rhombus;html=1;whiteSpace=wrap;fillColor=#7a43b6;strokeColor=#7a43b6;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="956" y="582" width="36" height="36" as="geometry"/></mxCell><mxCell id="c14" value="" style="rhombus;html=1;whiteSpace=wrap;fillColor=#2e7d32;strokeColor=#2e7d32;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1464" y="582" width="36" height="36" as="geometry"/></mxCell><mxCell id="c15" value="Proof, not promises: a link, a 30-second recording, a scorecard. The check-ins are 10 points of the grade, and they are what make Day 8 calm." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="720" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Pairs: one agent engineer (graph or crew, prompts, tools) and one platform engineer (API, UI, evals, Docker). Swap one task mid-week so both of you can explain everything." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="760" width="760" height="70" as="geometry"/></mxCell><mxCell id="c17" value="The usual week" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="121" height="21" as="geometry"/></mxCell><mxCell id="c18" value="nothing runs yet…" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13;fontColor=#8a8886;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="475" y="172" width="118" height="18" as="geometry"/></mxCell><mxCell id="c19" value="everything at once" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13.5;fontColor=#7a0a13;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">