<mxfile host="app.diagrams.net" type="device"><diagram name="Three client briefs. Pick one per pair." id="e654f5d9ef4c"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Three client briefs. Pick one per pair.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Same six requirements · same API contract · same eval runner · one week" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1 · The Voice Receptionist&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Zaytoun Family Clinic (fictional)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#0e7c86;strokeColor=#0e7c86;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="490" height="88" as="geometry"/></mxCell><mxCell id="c6" value="&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;“Book me a dental check-up next Tuesday, sometime after four.”&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e6f4f5;strokeColor=#0e7c86;fontColor=#0a4d53;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="234" width="450" height="76" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ON YOUR CV&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;A bilingual voice agent that books through an MCP-wrapped scheduling API, behind an approval gate, with a measured eval suite.&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e6f4f5;strokeColor=#0e7c86;fontColor=#0a4d53;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="718" width="450" height="92" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2 · The IT Helpdesk Agent&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Nakhla Systems (fictional)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#5c2d91;strokeColor=#5c2d91;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="555" y="128" width="490" height="88" as="geometry"/></mxCell><mxCell id="c9" value="&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;“My VPN says NX-403 since this morning.”&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f1ebf8;strokeColor=#5c2d91;fontColor=#3b1d5e;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="575" y="234" width="450" height="76" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;ON YOUR CV&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;A RAG support agent with cited answers, policy precedence in code and approval-gated ticketing, measured with an eval suite.&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f1ebf8;strokeColor=#5c2d91;fontColor=#3b1d5e;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="575" y="718" width="450" height="92" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;3 · The Trip Planning Crew&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Rihla (fictional start-up · real open data)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#b4500e;strokeColor=#b4500e;fontColor=#ffffff;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1070" y="128" width="490" height="88" as="geometry"/></mxCell><mxCell id="c12" value="&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;“3 days in Istanbul for two, $700, history and street food.”&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fbefe6;strokeColor=#b4500e;fontColor=#6b2f08;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="234" width="450" height="76" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;ON YOUR CV&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;A multi-agent planner on real open data: sourced, verified, budget-checked itineraries, revised on request and saved only on approval.&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fbefe6;strokeColor=#b4500e;fontColor=#6b2f08;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="718" width="450" height="92" as="geometry"/></mxCell><mxCell id="c14" value="&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Pairs · one week · the hidden tests run against the same contract for all three briefs. Pick the brief you would be proud to show an employer.&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3f2f1;strokeColor=#c8c6c4;fontColor=#605e5c;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c15" value="YOUR SYSTEM" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0e7c86;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="324" width="94" height="18" as="geometry"/></mxCell><mxCell id="c16" value="asks only what&amp;#x27;s missing · checks real slots · reads the choice&lt;br&gt;back · books only after a yes · confirms by voice" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#323130;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="64" y="346" width="420" height="42" as="geometry"/></mxCell><mxCell id="c17" value="THE PATTERN" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0e7c86;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="407" width="90" height="18" as="geometry"/></mxCell><mxCell id="c18" value="Conversational state machine + voice" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#323130;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="64" y="430" width="267" height="21" as="geometry"/></mxCell><mxCell id="c19" value="THE STACK" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0e7c86;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="471" width="74" height="18" as="geometry"/></mxCell><mxCell id="c20" value="LangGraph · MCP · speech-to-text + text-to-speech · FastAPI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#323130;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="64" y="493" width="421" height="21" as="geometry"/></mxCell><mxCell id="c21" value="THE HARD PART" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0e7c86;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="534" width="106" height="18" as="geometry"/></mxCell><mxCell id="c22" value="Never book a slot the patient didn&amp;#x27;t hear and approve." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#323130;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="64" y="556" width="383" height="21" as="geometry"/></mxCell><mxCell id="c23" value="TRAPS WE WILL TEST" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0e7c86;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="598" width="134" height="18" as="geometry"/></mxCell><mxCell id="c24" value="an instruction hidden in speech · a slot that vanishes · the double&lt;b