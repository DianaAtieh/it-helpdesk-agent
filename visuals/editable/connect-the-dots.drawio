<mxfile host="app.diagrams.net" type="device"><diagram name="Connect the dots: every module is a layer of one real system" id="dd81ce5ca405"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Connect the dots: every module is a layer of one real system&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="You didn&amp;#x27;t take thirteen separate courses. You collected the parts of one machine. This week you assemble it." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="This week is integration, not a rewrite. Open your old labs: the file worth reopening for each layer is in CONNECT-THE-DOTS.md." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="800" width="520" height="62" as="geometry"/></mxCell><mxCell id="c6" value="1  Interface" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#1a3c5e;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1086" y="140" width="105" height="24" as="geometry"/></mxCell><mxCell id="c7" value="how does a person use it?  the kit&amp;#x27;s UI starter, or yours" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#3b3a39;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1086" y="169" width="343" height="18" as="geometry"/></mxCell><mxCell id="c8" value="2  Entry point" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#0078d4;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1086" y="224" width="124" height="24" as="geometry"/></mxCell><mxCell id="c9" value="how does anyone call it?  FastAPI + the contract" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#3b3a39;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1086" y="253" width="299" height="18" as="geometry"/></mxCell><mxCell id="c10" value="3  Orchestration" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#7a43b6;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1086" y="308" width="144" height="24" as="geometry"/></mxCell><mxCell id="c11" value="who does what, in which order, until when?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#3b3a39;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1086" y="337" width="269" height="18" as="geometry"/></mxCell><mxCell id="c12" value="4  Tools through MCP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#c98a00;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1086" y="392" width="191" height="24" as="geometry"/></mxCell><mxCell id="c13" value="how does it act on the client&amp;#x27;s systems?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#3b3a39;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1086" y="421" width="248" height="18" as="geometry"/></mxCell><mxCell id="c14" value="5  Knowledge &amp;amp; memory" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;fontColor=#00838f;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxG