urcePoint"/><mxPoint x="146" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="The human decides. Below this line no LLM is involved." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#c50f1f;fontColor=#7a0a13;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="492" as="sourcePoint"/><mxPoint x="1560" y="492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="POST /api/approve {action_id, approved: true}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0078d4;fontColor=#0078d4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="144" y="540" as="sourcePoint"/><mxPoint x="394" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="is this action_id pending and unused?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#c50f1f;fontColor=#c50f1f;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="404" y="578" as="sourcePoint"/><mxPoint x="914" y="578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="create_booking(payload) · Idempotency-Key = action_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#c50f1f;fontColor=#c50f1f;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="924" y="616" as="sourcePoint"/><mxPoint x="1174" y="616" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="POST /api/bookings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#c98a00;fontColor=#c98a00;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1184" y="654" as="sourcePoint"/><mxPoint x="1434" y="654" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="201 {booking_id: “BK-1042”} · or 409 / 503" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#605e5c;fontColor=#605e5c;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1436" y="692" as="sourcePoint"/><mxPoint x="926" y="692" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="reply + result {booking_id} · or an honest failure, result: null" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#605e5c;fontColor=#605e5c;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="916" y="730" as="sourcePoint"/><mxPoint x="146" y="730" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>