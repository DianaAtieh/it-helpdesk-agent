<mxfile host="app.diagrams.net" type="device"><diagram name="The approval gate: the LLM proposes, your code commits" id="143d3f77f846"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;The approval gate: the LLM proposes, your code commits&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#1a3c5e;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="The same rule in all three briefs: create_booking · create_ticket · save_trip" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#605e5c;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;The user&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;patient · employee · traveller&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eef2f6;strokeColor=#1a3c5e;fontColor=#1a3c5e;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="122" width="220" height="62" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Your API&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;FastAPI · the contract&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f2fc;strokeColor=#0078d4;fontColor=#0b3a66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="122" width="220" height="62" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Your agents&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;LLM + read-only tools&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3ecfb;strokeColor=#7a43b6;fontColor=#3d1f66;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="550" y="122" width="220" height="62" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Approval executor&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;your code, not the LLM&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fdecee;strokeColor=#c50f1f;fontColor=#7a0a13;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="810" y="122" width="220" height="62" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;MCP server&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;from the kit&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff5e1;strokeColor=#c98a00;fontColor=#5c3b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1070" y="122" width="220" height="62" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;System of record&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;simulated by the kit&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff5e1;strokeColor=#c98a00;fontColor=#5c3b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1330" y="122" width="220" height="62" as="geometry"/></mxCell><mxCell id="c11" value="The write tool is not in the LLM&amp;#x27;s tool list. Only this code can call it." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="365" height="62" as="geometry"/></mxCell><mxCell id="c12" value="approved: false → nothing is written. The agent offers the next step." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="425" y="768" width="365" height="62" as="geometry"/></mxCell><mxCell id="c13" value="Approve twice → same Idempotency-Key → one booking, not two." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="768" width="365" height="62" as="geometry"/></mxCell><mxCell id="c14" value="Never show an ID the system of record did not return." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;spacingLeft=8;fillColor=#fff8c5;strokeColor=#d4b106;fontColor=#4d4000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="768" width="365" height="62" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#c8c6c4;fontColor=#c8c6c4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="184" as="sourcePoint"/><mxPoint x="140" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#c8c6c4;fontColor=#c8c6c4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="184" as="sourcePoint"/><mxPoint x="400" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#c8c6c4;fontColor=#c8c6c4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="184" as="sourcePoint"/><mxPoint x="660" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#c8c6c4;fontColor=#c8c6c4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="184" as="sourcePoint"/><mxPoint x="920" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#c8c6c4;fontColor=#c8c6c4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="184" as="sourcePoint"/><mxPoint x="1180" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#c8c6c4;fontColor=#c8c6c4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;startArrow=none;startFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="184" as="sourcePoint"/><mxPoint x="1440" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="POST /api/chat · “Book me a check-up Tuesday after 4”" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0078d4;fontColor=#0078d4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="144" y="228" as="sourcePoint"/><mxPoint x="394" y="228" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="run the graph / the crew" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0078d4;fontColor=#0078d4;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="404" y="266" as="sourcePoint"/><mxPoint x="654" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="find_slots(…) · a read-only tool" style="edgeStyle=orthogonalEdgeStyle;rounded=