# Copy to .env (which is gitignored) and fill in your own key. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
# Chat model for your agent (not used by ingestion or retrieval)
MODEL=

HELPDESK_API_KEY=dev-key-change-me
HELPDESK_API_URL=http://127.0.0.1:8102
# APP_URL (the UI's address for this app) defaults to http://127.0.0.1:8000. Avoid "localhost" on Windows:
# it resolves to ::1 first, and the refused IPv6 attempt costs ~2 s per connection before IPv4 is tried.

# Our app: POST /reset of ALL sessions needs this value in the X-Admin-Token header.
# Leave empty to disable resetting all sessions. Use a long random value on a server.
APP_ADMIN_TOKEN=

# Optional bounded evidence evaluation between retrieval and answer (1 extra search, 2 extra model calls per turn
# at most). Off unless set to true.
EVIDENCE_EVALUATION=

# AI verifier of final answers (app/agent/answer_verifier.py): after every code check, one extra model call judges
# each model-written answer sentence by sentence and may only drop sentences or give the honest fallback.
# On unless set to false. Fixed replies (refusals, incidents, status, ticket drafts) never use it.
ANSWER_VERIFICATION=true
